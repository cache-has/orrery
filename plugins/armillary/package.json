{
  "name": "@orrery/armillary-plugin",
  "version": "0.1.0",
  "description": "Armillary sink plugin that publishes pipeline outputs to Orrery via DuckDB",
  "type": "module",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "Horizon Analytic Studios, LLC",
  "scripts": {
    "build": "tsup",
    "bundle": "tsup && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "apache-arrow": "^21.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
