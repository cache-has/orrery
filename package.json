{
  "name": "@horizon-analytic/orrery",
  "version": "2.1.0",
  "description": "Open-source, code-defined BI dashboards. Dashboards as code, not clicks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orrery": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/dev.ts dev",
    "dev:pagila": "tsx src/cli/dev.ts dev --project examples/pagila",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run integration",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli/validate.ts",
    "build:grammar": "node scripts/build-grammar.mjs",
    "prepack": "npm run build && node scripts/stage-editor-client.mjs",
    "postpack": "node scripts/stage-editor-client.mjs --clean"
  },
  "keywords": [
    "dashboard",
    "bi",
    "analytics",
    "dashboards-as-code",
    "sql"
  ],
  "author": "Cache McClure <cache@horizonanalytic.com> (Horizon Analytic Studios, LLC)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@hono/node-server": "^2.1.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.5",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.5",
    "marked": "^18.0.11",
    "mysql2": "^3.24.2",
    "open": "^11.0.2",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@google-cloud/storage": "^8.0.1"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "uuid": "^11.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cache-has/orrery.git"
  },
  "bugs": {
    "url": "https://github.com/cache-has/orrery/issues"
  },
  "homepage": "https://github.com/cache-has/orrery#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "editor-client",
    "actions",
    "templates"
  ]
}
